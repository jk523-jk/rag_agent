# ============================================================================
# lab-hazmat-agent（Python 后端）专用忽略规则
# 仓库根另有一份覆盖全仓的 .gitignore，本文件用于本目录被单独使用时
# ============================================================================

# ---- 敏感配置：绝不能提交，含 LLM Key 与数据库口令 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
ENV/
env/

# 测试 / 类型检查 / Lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 运行时数据 ----
# 向量库（由 python -m app.rag.ingest 重建）
chroma/
data/
*.sqlite3
*.db

# 日志
logs/
*.log

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
