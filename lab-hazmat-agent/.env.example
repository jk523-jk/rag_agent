# ============================================================================
# 复制本文件为 .env 后填写真实值。本文件可安全提交；.env 不要提交。
# ============================================================================

# ---- 大模型与向量（OpenAI 兼容协议）----
# 可指向 DashScope 兼容模式、或任何兼容 OpenAI 协议的内网模型网关
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=qwen-plus
EMBED_MODEL=text-embedding-v3
LLM_TIMEOUT=60

# ============================================================================
# MySQL —— 本地 Docker 与云数据库的切换都在这一段
# ============================================================================
# 方式 A：本地 Docker（默认，配合 docker compose up -d mysql）
#   MYSQL_HOST=mysql
# 方式 B：云数据库（阿里云 RDS / 腾讯云 CDB / 华为云 RDS / 自建云主机）
#   MYSQL_HOST 填实例地址。能用内网地址就用内网地址：延迟低、不走公网计费，
#   且多数云厂商的公网地址默认不在白名单里。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=lab_hazmat
MYSQL_USER=lab_readonly
MYSQL_PASSWORD=change_me
MYSQL_CHARSET=utf8mb4

# 连接池与超时
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10
MYSQL_POOL_RECYCLE=1800
# 公网访问云实例时首包握手较慢，可放宽到 15~20
MYSQL_CONNECT_TIMEOUT=10

# TLS。云厂商普遍要求或建议加密连接，接云库时置 true。
# 需要严格校验证书时，把厂商的 CA 证书路径填到 MYSQL_SSL_CA
MYSQL_SSL=false
MYSQL_SSL_CA=

# 建表脚本位置。留空则自动在仓库 mysql/init/ 与容器 /app/mysql/init/ 中查找。
# 云库手工建表、脚本放在别处时，在这里指定绝对路径。
MYSQL_DDL_PATH=

# ---- 数据库初始化（仅 docker compose 首次启动 mysql 时使用）----
MYSQL_ROOT_PASSWORD=root_change_me

# ---- 向量库 ----
CHROMA_DIR=/data/chroma

# ---- 只读护栏 ----
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=8000

# ---- RAG 检索 ----
RAG_SCORE_THRESHOLD=0.30
RAG_FETCH_K=20
RAG_TOP_K=4

# ---- 业务可调参数（不重新发版即可调整）----
LOSS_THRESHOLD_RATIO=0.05
LOSS_THRESHOLD_ABS=1
ACCESS_CHECK_CONCURRENCY=5
SESSION_TTL_SECONDS=3600

# ---- 运行 ----
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost
