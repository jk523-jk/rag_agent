  "cards": [
    {
      "dot": "rose",
      "title": "权限在服务端落实",
      "items": [
        "前端路由守卫提供导航体验；FastAPI 会话依赖再次检查角色、实验室范围、CSRF 与首次改密状态。",
        "普通用户只能读取本人数据；系统管理 API 另行要求 system_admin。"
      ]
    },
    {
      "dot": "emerald",
      "title": "存储选择",
      "items": [
        "账号、会话、申请与审计始终保存在应用 SQLite。",
        "业务快照默认读应用库；切到 mysql 时读取原业务库，不会在故障时静默切换。"
      ]
    },
    {
      "dot": "cyan",
      "title": "既有 AI 能力",
      "items": [
        "聊天、Agent 与巡检入口仅对系统管理员开放。",
        "模型端点由 LLM_BASE_URL 配置；SQLite 模式下 SQL 工具只物化业务表到内存查询库。"
      ]
    }
  ]
